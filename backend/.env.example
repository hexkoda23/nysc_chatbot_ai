# LLM
NYSC_API_KEY=your_groq_api_key_here
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_BASE=https://api.groq.com/openai/v1
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto

# BM25 Retrieval Settings
TOP_K=5
MIN_BM25_SCORE=0.2
MIN_RETRIEVAL_SCORE=0.2
RAG_DOCS_PATH=./rag

# Optional web search
SERPAPI_KEY=your_serpapi_key_here

# App
DATABASE_URL=sqlite:///./nysc_chatbot.db
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
